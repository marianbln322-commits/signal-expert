# Local runtime
API_HOST=127.0.0.1
API_PORT=4100
DATABASE_PATH=data/signal-expert.db
PUBLIC_DIRECTORY=public
MIGRATION_DIRECTORY=migrations

# Official MEXC is primary. Binance public market-data API is an explicit,
# visibly attributed fallback when MEXC is unreachable; it is never labeled MEXC.
MEXC_SPOT_BASE_URL=https://api.mexc.com
MARKET_FAILOVER_ENABLED=true
FALLBACK_MARKET_BASE_URL=https://data-api.binance.vision
PROVIDER_TIMEOUT_MS=5000
PROVIDER_ATTEMPTS=2
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
TICKER_POLL_MS=3000
CANDLE_POLL_MS=15000
STALE_AFTER_MS=30000

# Paper research assumptions — NOT live MEXC Event Futures values.
PAPER_PAYOUT_RATE=0.80
PAPER_INITIAL_BANKROLL=1200
PAPER_DAILY_LOSS_LIMIT=60
PAPER_MAX_OPEN_POSITIONS=2
PAPER_BTC_MAX_STAKE=250
PAPER_ETH_MAX_STAKE=150

# Live execution is deliberately unavailable until an official Event Futures API is verified.
TRADING_MODE=paper
