# Local runtime
API_HOST=127.0.0.1
API_PORT=4100
DATABASE_PATH=data/signal-expert.db
PUBLIC_DIRECTORY=public
MIGRATION_DIRECTORY=migrations

# Official MEXC is primary. Binance public market-data API is an explicit,
# visibly attributed fallback when MEXC is unreachable; it is never labeled MEXC.
MEXC_SPOT_BASE_URL=https://api.mexc.com
MARKET_FAILOVER_ENABLED=true
FALLBACK_MARKET_BASE_URL=https://data-api.binance.vision
PROVIDER_TIMEOUT_MS=5000
PROVIDER_ATTEMPTS=2
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
TICKER_POLL_MS=3000
CANDLE_POLL_MS=15000
STALE_AFTER_MS=30000

# Entry-quality gates. Spread is calculated from the validated Spot order book,
# not from an unverified Event Futures contract book.
ENTRY_TRIGGER_GRACE_MS=90000
ENTRY_BTC_MAX_SPREAD_BPS=2
ENTRY_ETH_MAX_SPREAD_BPS=3
ENTRY_MIN_TOP_NOTIONAL_USDT=100
# Maximum local receipt-time skew between ticker and depth observations from the same provider.
ENTRY_MAX_SOURCE_SKEW_MS=10000

# Optional attributed Trading Economics macro calendar. Keep disabled unless a
# valid server-side credential is configured. Disabled is reported as SKIPPED,
# meaning no macro/news filtering occurred; it is not CLEAR or PASS. When enabled,
# stale/unavailable calendar data and high-impact USD blackout windows block entries.
EVENT_RISK_ENABLED=false
EVENT_RISK_BASE_URL=https://api.tradingeconomics.com
EVENT_RISK_API_KEY=
EVENT_RISK_POLL_MS=300000
EVENT_RISK_STALE_AFTER_MS=900000
EVENT_RISK_PRE_WINDOW_MS=1800000
EVENT_RISK_POST_WINDOW_MS=900000
EVENT_RISK_MIN_IMPORTANCE=3

# Paper research assumptions — NOT live MEXC Event Futures values.
PAPER_PAYOUT_RATE=0.80
PAPER_INITIAL_BANKROLL=500
PAPER_DAILY_LOSS_LIMIT=10
PAPER_MAX_OPEN_POSITIONS=2
PAPER_BTC_MAX_STAKE=250
PAPER_ETH_MAX_STAKE=150

# Autonomous execution is internal PAPER-only scheduling. It never enables live orders.
AUTONOMOUS_ENABLED=true
AUTONOMOUS_STAKE_PROFILE=adaptive
AUTONOMOUS_SCAN_MS=5000
AUTONOMOUS_SYMBOLS=BTCUSDT,ETHUSDT
AUTONOMOUS_HORIZONS=10,30
AUTONOMOUS_BASE_STAKE_FRACTION=0.005
AUTONOMOUS_MAX_STAKE_FRACTION=0.02
AUTONOMOUS_ABSOLUTE_STAKE_CAP=25
# Stop opening new autonomous PAPER positions after realized daily net profit reaches
# this stop-at-profit threshold. This is a safety stop, not promised income.
AUTONOMOUS_DAILY_PROFIT_TARGET=100
AUTONOMOUS_DAILY_LOSS_LIMIT=10
AUTONOMOUS_SEGMENT_GATE_ENABLED=true
AUTONOMOUS_SEGMENT_MIN_SAMPLE=20
AUTONOMOUS_STANDARD_THRESHOLD=68
AUTONOMOUS_HIGH_THRESHOLD=78
AUTONOMOUS_EXCEPTIONAL_THRESHOLD=88
AUTONOMOUS_OBSERVED_LADDER=10,30,90,270

# Durable manual research signals use Spot-proxy observations only. They never place orders
# and are enabled by default only in paper mode.
MANUAL_SIGNALS_ENABLED=true
MANUAL_SIGNAL_SCAN_MS=3000
# The proxy setup-ready state is valid only inside this short research window.
# Later cards remain tracking-only, and no state is a verified live-entry instruction.
MANUAL_SIGNAL_ENTRY_WINDOW_MS=30000
MANUAL_SIGNAL_MAX_RESOLUTION_LAG_MS=30000
MANUAL_SIGNAL_MIN_DECISIVE_SAMPLE=20
# After enough prospective observations, block segments whose Wilson 95% upper bound is below break-even.
MANUAL_SIGNAL_CONFIDENCE_GATE_ENABLED=true

# Live execution is deliberately unavailable until an official Event Futures API is verified.
TRADING_MODE=paper
